{
    "openapi": "3.0.0",
    "info": {
        "title": "API Raízes do Nordeste - Back-End",
        "description": "Documentação oficial e interativa do sistema de pedidos multicanal e controle de estoque.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:5432",
            "description": "Servidor de Desenvolvimento Local"
        }
    ],
    "paths": {
        "/auth/login": {
            "post": {
                "summary": "Realizar login",
                "description": "Autentica o usuário e emite o token Bearer JWT.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": { "type": "string", "example": "cliente@email.com" },
                                    "senha": { "type": "string", "example": "SenhaSegura123!" }
                                },
                                "required": ["email", "senha"]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login realizado com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "token": { "type": "string", "example": "eyJhbGciOiJIUz..." },
                                        "tipo": { "type": "string", "example": "Bearer" }
                                    }
                                }
                            }
                        }
                    },
                    "401": { "description": "Credenciais inválidas" }
                }
            }
        },
        "/unidades/{unidadeId}/produtos": {
            "get": {
                "summary": "Listar cardápio da unidade",
                "description": "Retorna todos os produtos cadastrados e seus saldos de estoque locais.",
                "parameters": [
                    {
                        "name": "unidadeId",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "integer" },
                        "description": "ID numérico da franquia física"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista de produtos retornada com sucesso"
                    }
                }
            }
        },
        "/unidades/{unidadeId}/pedidos": {
            "get": {
                "summary": "Listar pedidos da unidade",
                "description": "Retorna todos os pedidos de uma unidade específica, opcionalmente filtrados por canal de pedido.",
                "parameters": [
                    {
                        "name": "unidadeId",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "integer" },
                        "description": "ID numérico da unidade de preparação"
                    },
                    {
                        "name": "canalPedido",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": ["APP", "TOTEM", "BALCAO", "WEB", "PICKUP"]
                        },
                        "description": "Filtro opcional para listar pedidos de um canal específico"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista de pedidos retornada com sucesso"
                    },
                    "400": {
                        "description": "Filtro canalPedido inválido"
                    }
                }
            }
        },
        "/pedidos": {
            "post": {
                "summary": "Criar um pedido multicanal",
                "description": "Registra um pedido validando estoque local e exigindo a origem de venda.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "unidadeId": { "type": "integer", "example": 1 },
                                    "canalPedido": { "type": "string", "enum": ["APP", "TOTEM", "BALCAO", "WEB", "PICKUP"], "example": "TOTEM" },
                                    "itens": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "produtoId": { "type": "integer", "example": 10 },
                                                "quantidade": { "type": "integer", "example": 2 }
                                            }
                                        }
                                    }
                                },
                                "required": ["unidadeId", "canalPedido", "itens"]
                            }
                        }
                    }
                },
                "responses": {
                    "201": { "description": "Pedido registrado com sucesso" },
                    "400": { "description": "Campo obrigatório ausente ou inválido (ex: canalPedido)" },
                    "409": { "description": "Estoque insuficiente para um ou mais itens" }
                }
            }
        }
    }
}
