// Este arquivo gerado pelo prisma define o modelo de dados e as configurações do banco de dados para a aplicação. Ele inclui definições de modelos, enums e relacionamentos entre tabelas.
// foi gerado a partir da criação do banco no postgres, e pode ser usado para gerar o client do prisma e manter a consistência do banco de dados com o código da aplicação.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


enum PerfilUsuario {
  ADMIN
  GERENTE
  CLIENTE
  COZINHA
  ATENDENTE
}

enum CanalPedido {
  APP
  WEB
  BALCAO
  TOTEM
  PICKUP
}

enum StatusPedido {
  AGUARDANDO_PAGAMENTO
  EM_PREPARACAO
  PRONTO
  ENTREGUE
  CANCELADO
}

model Usuario {
  id                BigInt        @id @default(autoincrement())
  nome              String        @db.VarChar(100)
  email             String        @unique @db.VarChar(100)
  senha             String        @db.VarChar(255)
  perfil            PerfilUsuario @default(CLIENTE)
  ativo             Boolean       @default(true)
  createdAt         DateTime      @default(now()) @map("created_at")
  pedidos           Pedido[]
  fidelidade        Fidelidade?
  logsAuditoria     LogAuditoria[]

  @@map("usuarios")
}

model Unidade {
  id       BigInt   @id @default(autoincrement())
  nome     String   @db.VarChar(100)
  endereco String?  @db.Text
  ativa    Boolean  @default(true)
  
  // Relacionamentos existentes
  estoque  EstoqueUnidade[]
  pedidos  Pedido[]
  produtos Produto[]

  @@map("unidades")
}

model Produto {
  id          BigInt   @id @default(autoincrement())
  nome        String   @db.VarChar(100)
  descricao   String?  @db.Text
  categoria   String?  @db.VarChar(50)
  precoBase   Decimal  @map("preco_base") @db.Decimal(10, 2)

  // Esta coluna faz referencia ao relacionamento com Unidade e produto
  unidadeId   BigInt   @map("unidade_id")
  unidade     Unidade  @relation(fields: [unidadeId], references: [id])

  // Relacionamentos existentes
  estoque     EstoqueUnidade[]
  itensPedido ItemPedido[]

  @@map("produtos")
}

model EstoqueUnidade {
  id         BigInt  @id @default(autoincrement())
  unidadeId  BigInt  @map("unidade_id")
  produtoId  BigInt  @map("produto_id")
  quantidade Int     @default(0)
  unidade    Unidade @relation(fields: [unidadeId], references: [id])
  produto    Produto @relation(fields: [produtoId], references: [id])

  @@unique([unidadeId, produtoId])
  @@map("estoque_unidade")
}

model Pedido {
  id          BigInt       @id @default(autoincrement())
  usuarioId   BigInt       @map("usuario_id")
  unidadeId   BigInt       @map("unidade_id")
  canalPedido CanalPedido  @default(APP) @map("canal_pedido")
  status      StatusPedido @default(AGUARDANDO_PAGAMENTO)
  valorTotal  Float        @default(0.00) @map("valor_total")
  createdAt   DateTime     @default(now()) @map("created_at")
  usuario     Usuario      @relation(fields: [usuarioId], references: [id])
  unidade     Unidade      @relation(fields: [unidadeId], references: [id])
  itens       ItemPedido[]
  pagamentos  Pagamento[]

  @@map("pedidos")
}

model ItemPedido {
  id            BigInt  @id @default(autoincrement())
  pedidoId      BigInt  @map("pedido_id")
  produtoId     BigInt  @map("produto_id")
  quantidade    Int
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(10, 2)
  subtotal      Decimal @db.Decimal(10, 2)
  pedido        Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto       Produto @relation(fields: [produtoId], references: [id])

  @@map("itens_pedido")
}

model Pagamento {
  id        BigInt   @id @default(autoincrement())
  pedidoId  BigInt   @map("pedido_id")
  status    String   @db.VarChar(50)
  valor     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  pedido    Pedido   @relation(fields: [pedidoId], references: [id])

  @@map("pagamentos")
}

model Fidelidade {
  id               BigInt   @id @default(autoincrement())
  usuarioId        BigInt   @unique @map("usuario_id")
  pontosAcumulados Int      @default(0) @map("pontos_acumulados")
  ultimaAtualizacao DateTime @default(now()) @map("ultima_atualizacao")
  usuario          Usuario  @relation(fields: [usuarioId], references: [id])

  @@map("fidelidade")
}

model LogAuditoria {
  id        BigInt   @id @default(autoincrement())
  usuarioId BigInt?  @map("usuario_id")
  acao      String   @db.VarChar(100)
  detalhes  Json?
  timestamp DateTime @default(now())
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  @@map("logs_auditoria")
}